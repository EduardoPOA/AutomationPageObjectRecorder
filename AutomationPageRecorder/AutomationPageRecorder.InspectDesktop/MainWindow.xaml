<Window x:Class="AutomationPageRecorder.InspectDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionador de Elementos" Height="500" Width="400"
		Topmost="True">
    <Grid>
        <TextBlock x:Name="selectedElementTextBlock" 
                   Text="Clique em qualquer lugar da tela para selecionar um elemento." 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Top" 
                   TextAlignment="Center" 
                   FontSize="16" 
                   Margin="10" 
                   TextWrapping="Wrap"/>

        <StackPanel HorizontalAlignment="Left" Margin="10,50,10,0">
            <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                <TextBlock Text="Elemento Selecionado:" FontWeight="Bold" FontSize="14"/>
                <TextBlock x:Name="selectedElementNameTextBlock" FontSize="14" Foreground="Blue" FontWeight="Bold"/>
                <Button Content="🗒️" Click="CopyElementName" ToolTip="Copiar Nome" Width="30" Height="30" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                <TextBlock Text="Tipo:" FontWeight="Bold" FontSize="14"/>
                <TextBlock x:Name="elementTypeTextBlock" FontSize="14" Foreground="Blue" FontWeight="Bold"/>
                <Button Content="🗒️" Click="CopyElementType" ToolTip="Copiar Tipo" Width="30" Height="30" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                <TextBlock Text="ID:" FontWeight="Bold" FontSize="14"/>
                <TextBlock x:Name="elementIdTextBlock" FontSize="14" Foreground="Blue" FontWeight="Bold"/>
                <Button Content="🗒️" Click="CopyElementId" ToolTip="Copiar ID" Width="30" Height="30" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                <TextBlock Text="Classe:" FontWeight="Bold" FontSize="14"/>
                <TextBlock x:Name="elementClassTextBlock" FontSize="14" Foreground="Blue" FontWeight="Bold"/>
                <Button Content="🗒️" Click="CopyElementClass" ToolTip="Copiar Classe" Width="30" Height="30" />
            </StackPanel>

            <!-- Botão de Reinicialização -->
            <Button Content="Reiniciar Seleção" Click="RestartSelection" Width="150" Height="30" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</Window>
